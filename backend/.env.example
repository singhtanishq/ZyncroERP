APP_NAME="Zyncro ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

PAY_DB_HOST=127.0.0.1
PAY_DB_PORT=3306
PAY_DB_DATABASE=zyncro_erp_payments
PAY_DB_USERNAME=
PAY_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ----------------------------------------------------------------------
# Mail
# ----------------------------------------------------------------------
# Emails are sent through a real SMTP transport. Two common setups:
#
# LOCAL DEVELOPMENT (recommended) — run Mailpit as a local SMTP sink:
#   brew install mailpit
#   mailpit --listen 127.0.0.1:8025 --smtp 127.0.0.1:1025
# Every email the app sends is accepted over SMTP and viewable at
# http://localhost:8025 — the full transport chain is exercised.
#
# PRODUCTION — point MAIL_* at your SMTP provider's credentials.
#
# As a last resort MAIL_MAILER=log writes emails to laravel.log
# (useful for offline OTP testing; NOT real delivery).
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@zyncro.test"
MAIL_FROM_NAME="${APP_NAME}"

# Where support/contact links inside emails point to.
MAIL_SUPPORT_EMAIL="no-reply@localhost"

# ----------------------------------------------------------------------
# OTP / verification codes
# ----------------------------------------------------------------------
OTP_EXPIRATION_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000

# Extra CORS origins (comma-separated) beyond the local Vite dev servers.
CORS_ALLOWED_ORIGINS=

MIGRATION_SECRET=

# Shared password assigned to the five local test accounts on seed.
SEED_USER_PASSWORD=
